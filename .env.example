# VITE_SUPABASE_URL: URL Project Supabase
# Diperoleh dari dashboard Supabase: Project Settings -> API -> Project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public Anon Key Supabase
# Diperoleh dari dashboard Supabase: Project Settings -> API -> anon/public key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# VITE_APP_ENV: production | staging | demo
VITE_APP_ENV="production"
